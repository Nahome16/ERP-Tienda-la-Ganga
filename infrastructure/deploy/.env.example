# =====================================================================
# La Ganga ERP - configuración de producción (plantilla)
#
# 1) Copie este archivo:  cp .env.example .env
#    (o use ./init-env.sh, que lo crea y genera la contraseña por usted)
# 2) Complete los valores de abajo.
# 3) Proteja el archivo:  chmod 600 .env
#
# NUNCA suba el archivo .env a Git ni lo comparta por WhatsApp/correo.
# Reglas: sin espacios alrededor del "=". Si una contraseña tiene símbolos,
# enciérrela entre comillas simples: 'mi$clave'. Evite el apóstrofo (') en claves.
# =====================================================================

# ---- Sitio web ------------------------------------------------------
# Dominio que ya apunta (registro A) a la IP del VPS. Sin "https://" ni "/".
DOMINIO=sistema.mitienda.com
# Correo real: Let's Encrypt avisa aquí si el certificado tiene problemas.
ACME_EMAIL=admin@mitienda.com

# ---- Base de datos --------------------------------------------------
POSTGRES_DB=la_ganga
POSTGRES_USER=la_ganga
# Use una clave larga y generada, por ejemplo:  openssl rand -hex 24
# Solo letras y números (la API la usa dentro de una cadena de conexión).
# PostgreSQL solo la usa al crear el volumen por primera vez: si la cambia
# después, la base conserva la anterior (ver docs/21-despliegue-hostinger.md).
POSTGRES_PASSWORD=

# ---- Administrador inicial (solo para el primer arranque) -----------
# Se usan con:  docker compose -f compose.prod.yml run --rm cli --bootstrap-admin
# La contraseña debe tener 12 caracteres o más.
# DESPUÉS de crear el administrador, BORRE la línea LA_GANGA_ADMIN_PASSWORD.
LA_GANGA_ADMIN_USERNAME=administrador
LA_GANGA_ADMIN_DISPLAY_NAME=Administrador La Ganga
LA_GANGA_ADMIN_PASSWORD=

# ---- Zona horaria ---------------------------------------------------
TZ=America/Managua

# ---- Respaldos (todo opcional; ver docs/21-despliegue-hostinger.md) --
# Carpeta de respaldos (por defecto: infrastructure/deploy/backups)
# BACKUP_DIR=/home/ganga/respaldos
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=8
# Copia fuera del servidor (recomendado). Elija UNA forma:
#   con rclone (Google Drive, Dropbox, S3, etc.):  rclone:NOMBRE_DEL_REMOTO:carpeta
#   con scp (otro servidor por SSH con llave):     scp:usuario@servidor:/ruta/respaldos/
# BACKUP_REMOTE=rclone:mi-drive:respaldos-la-ganga
# BACKUP_REMOTE_KEEP_DAYS=90
